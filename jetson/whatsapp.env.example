# Copied to /etc/family-hub/whatsapp.env by jetson/setup.sh. Root-owned, mode 600.

# Where the gateway sends WhatsApp messages/photos for AI extraction.
# Point this at your deployed dashboard (Railway) or at the Jetson itself
# once you self-host the web app (http://127.0.0.1:3000/api/extract).
API_URL=https://your-web-app.up.railway.app/api/extract

# Must match API_TOKEN on the web app, otherwise the basic-auth gate rejects it.
API_TOKEN=

# Login state lives on the systemd StateDirectory so it survives restarts.
AUTH_DIR=/var/lib/family-hub/auth

# Port for the QR / pairing-code page: http://<jetson-ip>:8080
PORT=8080

# Optional: only process groups whose name contains this substring.
WA_GROUP=

# Optional: pairing-code login instead of QR (digits only, with country code).
WA_NUMBER=

# Not needed on the Jetson - it already has a residential IP.
PROXY_URL=

# Copy this file to ".env" (or ".env.local") and fill in your values.
# On the Jetson, jetson/setup.sh copies it to /opt/family-hub/.env, which is
# also what docker compose reads.

# --- AI extraction ---------------------------------------------------------
# The extractor tries providers in this order: (1) Google Gemini if
# GEMINI_API_KEY is set, (2) an OpenAI-compatible endpoint if LLM_BASE_URL +
# LLM_API_KEY are set, (3) an offline heuristic parser (no key needed).

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Strongly recommended: it's the only provider here that reads photos well.
# gemini-flash-latest always points at the current flash model, so leave
# GEMINI_MODEL alone unless you have a reason.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Any OpenAI-compatible chat API. Two useful cases:
#   Ollama on the Jetson (free, private, no photos):
#     LLM_BASE_URL=http://host.docker.internal:11434/v1
#     LLM_MODEL=qwen2.5:3b-instruct
#     LLM_API_KEY=ollama
#   NVIDIA-hosted models:
#     LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#     LLM_MODEL=google/gemma-3n-e4b-it
#     LLM_API_KEY=nvapi-xxxxxxxx
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Google Calendar -------------------------------------------------------
# Your calendar's PRIVATE ICS address (Google Calendar -> Settings -> your
# calendar -> "Secret address in iCal format"). Pulls your events onto the
# dashboard. Treat it as a password.
GOOGLE_ICS_URL=

# Token guarding the outgoing ICS feed at /api/calendar, which Google can
# subscribe to. Only useful if the dashboard is reachable from the internet.
# If unset, the feed falls back to accepting API_TOKEN.
CALENDAR_TOKEN=

# --- Access control --------------------------------------------------------
# When BOTH are set, the whole app requires HTTP Basic Auth. Leave empty for a
# LAN-only install; set them before exposing the dashboard through a tunnel.
APP_USERNAME=
APP_PASSWORD=

# Shared secret the WhatsApp gateway uses to POST to /api/extract past the
# password gate. Any long random string; the same value on both services.
API_TOKEN=

# --- Storage ---------------------------------------------------------------
# DATA_ROOT is the host directory holding everything (docker compose only).
# Put it on the NVMe, not the SD card. setup.sh appends this automatically.
DATA_ROOT=/opt/family-hub-data
# DATA_DIR is the in-process path to the JSON store + uploaded photos.
# Compose sets it to /data; locally it defaults to ./data.
DATA_DIR=

# --- WhatsApp gateway (whatsapp/ service) ----------------------------------
# Compose sets API_URL/AUTH_DIR itself; these matter for running it by hand.
API_URL=http://localhost:3000/api/extract
AUTH_DIR=auth
# Optional: only process groups whose name contains this substring.
WA_GROUP=
# Optional: pairing-code login instead of QR. Spare number, digits only with
# country code, e.g. 972501234567
WA_NUMBER=
# Optional: route WhatsApp through a residential/mobile proxy. Needed only on
# datacenter hosts, which reject the handshake; pointless from home.
PROXY_URL=
